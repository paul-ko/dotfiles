[user]
    email = pmkoenig@gmail.com
    name = Paul K
[color]
    branch = auto
    diff = auto
    interactive = auto
    pager = true
    status = auto
    ui = true
[core]
    editor = nvim
    safecrlf = false
    pager = delta  # requires installing git-delta (i.e., from apt)
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
[grep]
    fallbackToNoIndex = true
    patternType = perl
[init]
    defaultBranch = main
[pretty]
    date = %D
    concise = "%n%C(#bd93f9)%h %C(#50fa7b) %ci %C(#ff79c6) %an %C(auto) %n╘%d %s"
[push]
    recurseSubmodules = check
[merge]
    conflictStyle = zdiff3
    tool = meld
# Set the path to meld as
# [mergetool "meld"]
# 	path = <path>
